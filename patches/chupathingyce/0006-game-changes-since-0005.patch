+/* the run's indices drawn as one draw, in the run's state (as a draw from
+indices of the process's own, draw_indexed_vertices_untimed's) */
+static void merge_draw_run(void)
+{
+	unsigned long minimum = 0xffff, maximum = 0, index;
+	WORD *rebased;
