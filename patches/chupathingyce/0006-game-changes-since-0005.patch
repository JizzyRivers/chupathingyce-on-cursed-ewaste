+			}
+			fclose(file);
+		}
+		snprintf(maps_path, sizeof(maps_path), "%s.maps", path);
+		maps = fopen("/proc/self/maps", "r");
+		copy = fopen(maps_path, "w");
+		while (maps && copy && (length = fread(text, 1, sizeof(text), maps)) > 0)
