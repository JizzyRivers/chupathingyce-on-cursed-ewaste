diff --git a/port/linux/game/lighting_config.c b/port/linux/game/lighting_config.c
index 3471cf5f4..f97232140 100644
--- a/port/linux/game/lighting_config.c
+++ b/port/linux/game/lighting_config.c
@@ -9,6 +9,7 @@ chester's from GulchCE, where each was a setting of its own.
 The level is read again only when a setting changes (config_changes): a light
 or a draw asks for its parts many times a frame. */
 #include "lighting_config.h"
+#include <stdlib.h>
 #include <string.h>
 
 int config_boolean(const char *name);
@@ -79,7 +80,7 @@ int lighting_config_level(void)
 	return level;
 }
 
-int lighting_config_boolean(const char *name)
+static int lighting_config_lookup(const char *name)
 {
 	int level = lighting_config_level();
 	unsigned int i;
@@ -91,4 +92,40 @@ int lighting_config_boolean(const char *name)
 	}
 	return config_boolean(name);
 }
+
+/* (the answers by the name's address, the callers' literals: a model's
+draw asks several times, each a dozen string compares and, for a name not
+a part's, a look in the settings under their lock; asked again when a
+setting changes. HALO_NO_LIGHTING_CONFIG_CACHE: every time) */
+#define LIGHTING_CONFIG_CACHE 32
+
+int lighting_config_boolean(const char *name)
+{
+	static struct
+	{
+		const char *name;
+		int value;
+	} cache[LIGHTING_CONFIG_CACHE];
+	static unsigned long cached_at = (unsigned long)-1;
+	static int software = -1, caching = -1;
+	unsigned long slot;
+
+	if (caching < 0)
+		caching = !getenv("HALO_NO_LIGHTING_CONFIG_CACHE");
+	if (!caching)
+		return lighting_config_lookup(name);
+	if (cached_at != config_changes() || software != xgpu_software_renderer * 2 + xgpu_weak_renderer)
+	{
+		memset(cache, 0, sizeof(cache));
+		cached_at = config_changes();
+		software = xgpu_software_renderer * 2 + xgpu_weak_renderer;
+	}
+	slot = ((unsigned long)(size_t)name >> 2) % LIGHTING_CONFIG_CACHE;
+	if (cache[slot].name != name)
+	{
+		cache[slot].value = lighting_config_lookup(name);
+		cache[slot].name = name;
+	}
+	return cache[slot].value;
+}
 #endif
