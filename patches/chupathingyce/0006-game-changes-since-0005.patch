+	for (index = 0; index < merge.count; index++)
+	{
+		if (merge.indices[index] < minimum)
+			minimum = merge.indices[index];
+		if (merge.indices[index] > maximum)
+			maximum = merge.indices[index];
+	}
+	if (minimum > maximum)
