+/* ---------- a pass's draws of one state as one draw (merged)
+
+The level's fog pass is a draw for each of the level's materials in view (20
+to 29 on damnation, wizard and boardingaction), each with the state of the
+one before but for where its vertices start and its indices: about 0.08 ms
+of the driver's each. Between d3d8_gl_merge_pass(1) and (0) (render.c,
+around structure_render_fog, in performance mode) a triangle list's draw
+whose state is the one before's whole (render and texture states, textures,
+shaders, every constant), and whose vertices are at a whole number of
+vertices from the first's in every stream it reads, is added to that one:
+its indices moved by that number. The run is drawn as one draw when the
+state changes, at a draw of another kind, a clear, a change of target and
+at the pass's end, its triangles in the order they came. HALO_GLES2_NO_MERGE:
+as they come. */
+#define MERGE_INDICES 32768
+
+static struct
+{
+	int on;
+	/* the run's first draw (its state the run's), and the run's indices,
+	as the first draw's vertices count them */
+	struct sort_draw first;
+	int pending;
+	unsigned long draws;
+	WORD *indices;
+	unsigned long count;
+	unsigned long merged, runs, frame;
+} merge;
+
+/* the vertices draw b's stream starts at past draw a's, in every stream
+the vertex shader reads (FALSE where they are not a whole number of them,
+or not the same in all) */
+static BOOL merge_offset(const struct sort_draw *a, long *offset)
+{
+	const struct vertex_shader_object *declaration = device.vertex_shader;
+	const struct { DWORD data; UINT stride; } *streams_a = (const void *)a->streams;
+	unsigned long index;
+	BOOL found = FALSE;
+
+	if (!declaration || declaration != a->vertex_shader)
+		return FALSE;
+	for (index = 0; index < declaration->element_count; index++)
+	{
+		const struct vertex_element *element = &declaration->elements[index];
+		unsigned long stream = element->stream;
+		long stride = (long)device.streams[stream].stride, bytes, vertices;
+
+		if (element->type == D3DVSDT_NONE || !device.streams[stream].data)
+			continue;
+		if (!streams_a[stream].data || (long)streams_a[stream].stride != stride || stride <= 0)
+			return FALSE;
+		bytes = (long)(device.streams[stream].data - streams_a[stream].data) +
+			((long)device.base_vertex_index - (long)a->base_vertex_index) * stride;
+		if (bytes % stride)
+			return FALSE;
+		vertices = bytes / stride;
+		if (found && vertices != *offset)
+			return FALSE;
+		*offset = vertices;
+		found = TRUE;
+	}
+	return found;
+}
+
+/* whether the device's state is the run's, streams aside */
+static BOOL merge_state_same(const struct sort_draw *a)
+{
+	return !memcmp(a->render_state, D3D__RenderState, sizeof(a->render_state)) &&
+		!memcmp(a->texture_state, D3D__TextureState, sizeof(a->texture_state)) &&
+		!memcmp(a->textures, device.textures, sizeof(a->textures)) &&
+		!memcmp(a->palettes, device.palettes, sizeof(a->palettes)) &&
+		a->vertex_shader == device.vertex_shader &&
+		!memcmp(a->program_slots, device.program_slots, sizeof(a->program_slots)) &&
+		a->program_address == device.program_address && a->shader_constant_mode == device.shader_constant_mode &&
+		!memcmp(&a->viewport, &device.viewport, sizeof(a->viewport)) &&
+		!memcmp(a->attributes, device.attributes, sizeof(a->attributes)) &&
