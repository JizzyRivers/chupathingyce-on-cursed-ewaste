+#include <signal.h>
+#include <sys/time.h>
+#include <ucontext.h>
+
+#define PAIR_SLOTS 32768
+static volatile unsigned int pair_pc[PAIR_SLOTS], pair_lr[PAIR_SLOTS], pair_count[PAIR_SLOTS];
+
+static void pair_signal(int number, siginfo_t *information, void *context)
+{
+	ucontext_t *ucontext = context;
+	unsigned int pc = (unsigned int)ucontext->uc_mcontext.arm_pc, lr = (unsigned int)ucontext->uc_mcontext.arm_lr;
+	unsigned int slot = ((pc >> 2) ^ (lr * 2654435761u)) % PAIR_SLOTS, probe;
+
+	(void)number;
+	(void)information;
+	for (probe = 0; probe < 32; probe++, slot = (slot + 1) % PAIR_SLOTS)
+	{
+		if (!pair_count[slot] || (pair_pc[slot] == pc && pair_lr[slot] == lr))
+		{
+			pair_pc[slot] = pc;
+			pair_lr[slot] = lr;
+			pair_count[slot]++;
+			return;
+		}
+	}
