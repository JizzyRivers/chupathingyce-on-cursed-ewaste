+		const char *value = getenv("HALO_D3D_PAIRS");
+
+		start = value ? atol(value) : -1;
+		path = value ? strchr(value, ':') : NULL;
+		if (path)
+			path++;
+	}
+	if (start < 0 || !path)
+		return;
+	if (frame == (unsigned long)start)
+	{
+		struct sigaction action;
+		struct itimerval timer;
+
+		memset(&action, 0, sizeof(action));
+		action.sa_sigaction = pair_signal;
+		action.sa_flags = SA_SIGINFO | SA_RESTART;
+		sigaction(SIGPROF, &action, NULL);
+		timer.it_interval.tv_sec = 0;
+		timer.it_interval.tv_usec = 1000;
+		timer.it_value = timer.it_interval;
+		setitimer(ITIMER_PROF, &timer, NULL);
+	}
+	else if (frame == (unsigned long)start + 1200)
+	{
+		struct itimerval timer;
+		FILE *file, *maps, *copy;
+		char text[4096], maps_path[600];
+		size_t length;
+		unsigned int slot;
+
+		memset(&timer, 0, sizeof(timer));
+		setitimer(ITIMER_PROF, &timer, NULL);
+		file = fopen(path, "w");
+		if (file)
+		{
+			for (slot = 0; slot < PAIR_SLOTS; slot++)
+			{
+				if (pair_count[slot])
