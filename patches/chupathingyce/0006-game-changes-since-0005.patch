+static void merge_flush(void)
+{
+	if (!merge.pending)
+		return;
+	merge.pending = FALSE;
+	sort.replaying = TRUE;
+	sort_state_keep(&sort.last, 0, 0, NULL);
+	sort_state_apply(&merge.first);
+	if (merge.draws == 1)
+		draw_indexed_vertices_untimed(merge.first.type, merge.first.count, merge.first.indices);
+	else
