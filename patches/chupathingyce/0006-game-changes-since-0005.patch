+			merge.count += count;
+			merge.draws++;
+			return TRUE;
+		}
+	}
+	merge_flush();
+	sort_state_keep(&merge.first, type, count, indices);
+	memcpy(merge.indices, indices, count * sizeof(WORD));
+	merge.count = count;
+	merge.draws = 1;
+	merge.pending = TRUE;
+	return TRUE;
