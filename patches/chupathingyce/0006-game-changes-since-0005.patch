+
+/* A pass's fused draws in the order of their programs. The level's parts
+come in the order of their lightmaps and materials, and the driver's cost
+of a draw is mostly that of a change of program (0.25 to 0.3 ms, against
+under 0.1 for a draw with the program of the one before). They are opaque
+and depth tested, so their order does not show: between
+d3d8_gl_fuse_pass(1) and (0) they are kept whole, and drawn at the end
+with those of a program together. HALO_GLES2_NO_FUSE_SORT: as they come. */
+#define FUSE_DEFERRED 256
+
+struct fuse_deferred
+{
+	struct fuse_state a, b;
+	unsigned long key, order, group;
+	int alpha;
+};
+
+static struct
+{
+	int on;
+	unsigned long count;
+	struct fuse_deferred *draws;
+	unsigned short sorted[FUSE_DEFERRED];
+} fuse_pass;
+
+static unsigned long fuse_state_key(const struct fuse_state *state)
+{
+	struct nv2a_pixel_shader_key key;
+
+	memset(&key, 0, sizeof(key));
+	memcpy(key.combiner_state, state->render_state, sizeof(key.combiner_state));
+	memset(&key.combiner_state[D3DRS_PSCONSTANT0_0], 0, 16 * sizeof(DWORD));
+	key.combiner_state[D3DRS_PSFINALCOMBINERCONSTANT0] = 0;
+	key.combiner_state[D3DRS_PSFINALCOMBINERCONSTANT1] = 0;
+	return hash_words(key.combiner_state, sizeof(key.combiner_state)) ^
+		((unsigned long)(uintptr_t)state->program_slots[state->program_address] * 2654435761UL) ^
+		(state->render_state[D3DRS_ALPHATESTENABLE] ? 0x9e3779b9UL : 0);
+}
+
+static int fuse_deferred_compare(const void *a, const void *b)
+{
+	const struct fuse_deferred *first = &fuse_pass.draws[*(const unsigned short *)a];
+	const struct fuse_deferred *second = &fuse_pass.draws[*(const unsigned short *)b];
+
+	if (first->group != second->group)
+		return first->group < second->group ? -1 : 1;
+	if (first->key != second->key)
+		return first->key < second->key ? -1 : 1;
+	return first->order < second->order ? -1 : first->order > second->order;
+}
+
+/* B's draw kept with its A for the pass's end; FALSE to draw it now */
+static BOOL fuse_defer(D3DPRIMITIVETYPE type, UINT count, CONST WORD *indices)
+{
+	struct fuse_deferred *draw;
+
+	if (!fuse_pass.on || fuse.next >= fuse.count || fuse_pass.count == FUSE_DEFERRED)
+		return FALSE;
+	if (!fuse_pass.draws && !(fuse_pass.draws = malloc(FUSE_DEFERRED * sizeof(*fuse_pass.draws))))
+		return FALSE;
+	draw = &fuse_pass.draws[fuse_pass.count];
+	draw->a = fuse.captures[fuse.next++];
+	fuse_state_keep(&draw->b, type, count, indices);
+	draw->alpha = fuse.alpha;
+	draw->order = fuse_pass.count;
+	draw->key = fuse_state_key(&draw->a) * 31 + fuse_state_key(&draw->b);
+	fuse_pass.sorted[fuse_pass.count] = (unsigned short)fuse_pass.count;
+	fuse_pass.count++;
+	return TRUE;
+}
+
+void d3d8_gl_fuse_pass(int begin)
+{
+	static int sorting = -1, grouping = -1;
+	static struct fuse_state last;
+	unsigned long index;
+
+	if (sorting < 0)
+		sorting = !getenv("HALO_GLES2_NO_FUSE_SORT");
+	if (begin)
+	{
+		fuse_pass.on = sorting;
+		fuse_pass.count = 0;
+		return;
+	}
+	fuse_pass.on = FALSE;
+	if (!fuse_pass.count)
+		return;
+	/* (the device as the game left it, for after) */
+	fuse_state_keep(&last, 0, 0, NULL);
+	/* (keys whose draws were drawn with one program last time together, as
+	that program's: different combiner states can make one program.
+	HALO_GLES2_NO_FUSE_GROUP: by key alone) */
+	if (grouping < 0)
+		grouping = !getenv("HALO_GLES2_NO_FUSE_GROUP");
+	for (index = 0; index < fuse_pass.count; index++)
+	{
+		struct fuse_deferred *draw = &fuse_pass.draws[index];
+		GLuint program = grouping ? sort_program_of(draw->key) : 0;
+
+		draw->group = program ? program : 0x80000000UL | (draw->key >> 1);
+	}
+	qsort(fuse_pass.sorted, fuse_pass.count, sizeof(fuse_pass.sorted[0]), fuse_deferred_compare);
+	for (index = 0; index < fuse_pass.count; index++)
+	{
+		struct fuse_deferred *draw = &fuse_pass.draws[fuse_pass.sorted[index]];
+
+		fuse.captures[0] = draw->a;
+		fuse.count = 1;
+		fuse.next = 0;
+		fuse.alpha = draw->alpha;
+		fuse_state_apply(&draw->b);
+		fuse_draw(draw->b.type, draw->b.count, draw->b.indices);
+		sort_learn(draw->key, gl_state.program);
+	}
+	fuse.count = fuse.next = 0;
+	fuse_pass.count = 0;
+	fuse_state_apply(&last);
+}
+#endif
+
+#ifdef HALO_CONSOLE_GLES2
+/* ---------- a pass's opaque draws in the order of their programs (sorted)
+
+The driver's cost of a draw is mostly that of a change of program (0.2 to
+0.45 ms, against under 0.1 for a draw with the program of the one before),
+and the objects' draws come object by object: damnation's ten of one model
+are two parts each, of two programs (a skinned and a one-node vertex
+shader), twenty changes where two would draw the same. Between
+d3d8_gl_sort_pass(1) and (0) (render.c, around render_objects, in
+performance mode) a draw that writes depth over a depth test of LESS or
+LESSEQUAL, unblended, and that writes no stencil, is kept whole with the
+device's state, and drawn later with the others of its program together:
+each program's in the order they came, the programs in the order they
+first came. Any other draw, a clear, a change of
+target or a visibility test draws the kept ones first. Their order can only
+show where two of them are at the same depth; and the Xbox's GPU drew a
+frame's draws well after the game made them, so what they read stays as it
+was. HALO_GLES2_NO_SORT: as they come. */
+#define SORT_DRAWS 128
+#define SORT_KNOWN 256
+
+struct sort_draw
+{
+	DWORD render_state[D3DRS_MAX];
+	DWORD texture_state[D3DTSS_MAXSTAGES][D3DTSS_MAX];
+	D3DBaseTexture *textures[D3DTSS_MAXSTAGES];
+	D3DPalette *palettes[D3DTSS_MAXSTAGES];
+	struct vertex_shader_object *vertex_shader;
+	struct vertex_shader_object *program_slots[VERTEX_PROGRAM_SLOTS];
+	unsigned long program_address;
+	D3DSHADERCONSTANTMODE shader_constant_mode;
+	float constants[XGPU_VERTEX_CONSTANT_COUNT][4];
+	D3DVIEWPORT8 viewport;
+	float viewport_scale[4], viewport_offset[4];
+	float attributes[XGPU_VERTEX_ATTRIBUTE_COUNT][4];
+	unsigned char streams[sizeof(((struct gl_device *)0)->streams)];
+	UINT base_vertex_index;
+	WORD *index_data;
+	int mcc;
+	D3DPRIMITIVETYPE type;
+	UINT count;
+	CONST WORD *indices;
+	unsigned long key;
+	unsigned long group, order;
+};
+
+static struct
+{
+	int on, replaying;
+	unsigned long count;
+	struct sort_draw *draws, last;
+	unsigned short sorted[SORT_DRAWS];
+	/* the program each key's draws were last drawn with: keys that differ
+	where the program does not are drawn together */
+	struct
+	{
+		unsigned long key;
+		GLuint program;
+	} known[SORT_KNOWN];
+	unsigned long kept, apart, flushes, frame;
+} sort;
+
+static GLuint sort_program_of(unsigned long key)
+{
+	unsigned long slot = key % SORT_KNOWN;
+
+	return sort.known[slot].key == key ? sort.known[slot].program : 0;
+}
+
+static void sort_learn(unsigned long key, GLuint program)
+{
+	unsigned long slot = key % SORT_KNOWN;
+
+	sort.known[slot].key = key;
+	sort.known[slot].program = program;
+}
+
+static void sort_state_keep(struct sort_draw *state, D3DPRIMITIVETYPE type, UINT count, CONST WORD *indices)
+{
+	memcpy(state->render_state, D3D__RenderState, sizeof(state->render_state));
+	memcpy(state->texture_state, D3D__TextureState, sizeof(state->texture_state));
+	memcpy(state->textures, device.textures, sizeof(state->textures));
+	memcpy(state->palettes, device.palettes, sizeof(state->palettes));
+	state->vertex_shader = device.vertex_shader;
+	memcpy(state->program_slots, device.program_slots, sizeof(state->program_slots));
+	state->program_address = device.program_address;
+	state->shader_constant_mode = device.shader_constant_mode;
+	memcpy(state->constants, device.constants, sizeof(state->constants));
+	state->viewport = device.viewport;
+	memcpy(state->viewport_scale, device.viewport_scale, sizeof(state->viewport_scale));
+	memcpy(state->viewport_offset, device.viewport_offset, sizeof(state->viewport_offset));
+	memcpy(state->attributes, device.attributes, sizeof(state->attributes));
+	memcpy(state->streams, device.streams, sizeof(state->streams));
+	state->base_vertex_index = device.base_vertex_index;
+	state->index_data = D3D__IndexData;
+	state->mcc = mcc_environment_shader_active();
+	state->type = type;
+	state->count = count;
+	state->indices = indices;
+}
+
+static void sort_state_apply(const struct sort_draw *state)
+{
+	memcpy(D3D__RenderState, state->render_state, sizeof(state->render_state));
+	memcpy(D3D__TextureState, state->texture_state, sizeof(state->texture_state));
+	memcpy(device.textures, state->textures, sizeof(state->textures));
+	memcpy(device.palettes, state->palettes, sizeof(state->palettes));
+	device.vertex_shader = state->vertex_shader;
+	memcpy(device.program_slots, state->program_slots, sizeof(state->program_slots));
+	device.program_address = state->program_address;
+	device.shader_constant_mode = state->shader_constant_mode;
+	/* (only the registers that differ are marked changed) */
+	constants_store(0, state->constants, XGPU_VERTEX_CONSTANT_COUNT);
+	device.viewport = state->viewport;
+	memcpy(device.viewport_scale, state->viewport_scale, sizeof(state->viewport_scale));
+	memcpy(device.viewport_offset, state->viewport_offset, sizeof(state->viewport_offset));
+	memcpy(device.attributes, state->attributes, sizeof(state->attributes));
+	memcpy(device.streams, state->streams, sizeof(state->streams));
+	device.base_vertex_index = state->base_vertex_index;
+	D3D__IndexData = state->index_data;
+	mcc_environment_shader_set(state->mcc);
+}
+
+/* what a draw's program is made of, as far as the device's state says
+(the program it was drawn with is learned: sort_learn) */
+static unsigned long sort_state_key(void)
+{
+	DWORD combiner[sizeof(((struct nv2a_pixel_shader_key *)0)->combiner_state) / sizeof(DWORD)];
+	unsigned long key;
+	int stage;
+
+	memcpy(combiner, D3D__RenderState, sizeof(combiner));
+	memset(&combiner[D3DRS_PSCONSTANT0_0], 0, 16 * sizeof(DWORD));
+	combiner[D3DRS_PSFINALCOMBINERCONSTANT0] = 0;
+	combiner[D3DRS_PSFINALCOMBINERCONSTANT1] = 0;
+	key = hash_words(combiner, sizeof(combiner));
+	key ^= (unsigned long)(uintptr_t)current_program() * 2654435761UL;
+	key = key * 31 + D3D__RenderState[D3DRS_PSTEXTUREMODES];
+	key = key * 31 + (D3D__RenderState[D3DRS_ALPHATESTENABLE] ? D3D__RenderState[D3DRS_ALPHAFUNC] : 0);
+	key = key * 31 + (D3D__RenderState[D3DRS_FOGENABLE] ? 1 + D3D__RenderState[D3DRS_FOGTABLEMODE] : 0);
+	key = key * 31 + (unsigned long)mcc_environment_shader_active();
+	for (stage = 0; stage < D3DTSS_MAXSTAGES; stage++)
+	{
+		key = key * 31 + (device.textures[stage] ? 1 : 0);
+		key = key * 31 + D3D__TextureState[stage][D3DTSS_ALPHAKILL];
+		key = key * 31 + D3D__TextureState[stage][D3DTSS_COLORSIGN];
+	}
+	return key;
+}
+
+/* whether a draw's order among the others kept cannot show */
+static BOOL sort_draw_fits(void)
+{
+	const DWORD *state = D3D__RenderState;
+	struct vertex_shader_object *program = current_program();
+
+	/* (the Light effects' lights are the game's for the draw's object: none
+	on a console) */
+	if (!program || (program->plasma_model && plasma_model_lighting_mask()) || device.visibility_test_active ||
+		device.immediate_active)
+		return FALSE;
+	if (state[D3DRS_ALPHABLENDENABLE] || !state[D3DRS_ZENABLE] || !state[D3DRS_ZWRITEENABLE] ||
+		(state[D3DRS_ZFUNC] != D3DCMP_LESSEQUAL && state[D3DRS_ZFUNC] != D3DCMP_LESS))
+	{
+		return FALSE;
+	}
+	/* (a stencil tested but not written, as the objects' is, EQUAL 0: the
+	same for all of them, as none of those kept writes it; a draw that writes
+	it draws the kept ones first) */
+	if (state[D3DRS_STENCILENABLE] && (state[D3DRS_STENCILWRITEMASK] & 0xff) &&
+		(state[D3DRS_STENCILFAIL] != D3DSTENCILOP_KEEP || state[D3DRS_STENCILZFAIL] != D3DSTENCILOP_KEEP ||
+			state[D3DRS_STENCILPASS] != D3DSTENCILOP_KEEP))
+	{
+		return FALSE;
+	}
+	return TRUE;
+}
+
+static int sort_draw_compare(const void *a, const void *b)
+{
+	const struct sort_draw *first = &sort.draws[*(const unsigned short *)a];
+	const struct sort_draw *second = &sort.draws[*(const unsigned short *)b];
+
+	if (first->group != second->group)
+		return first->group < second->group ? -1 : 1;
+	return first->order < second->order ? -1 : first->order > second->order;
+}
+
+/* the kept draws drawn, sorted, and the device as the game has it after */
+static void sort_flush(void)
+{
+	unsigned long index, other;
+
+	merge_flush();
+	if (!sort.count || sort.replaying)
+		return;
+	sort.flushes++;
+	sort_state_keep(&sort.last, 0, 0, NULL);
+	/* each draw's group: the first of the draws of its program (by the
+	program its key was drawn with last, else by its key) */
+	for (index = 0; index < sort.count; index++)
+	{
+		struct sort_draw *draw = &sort.draws[index];
+		GLuint program = sort_program_of(draw->key);
+
+		draw->group = index;
+		for (other = 0; other < index; other++)
+		{
+			const struct sort_draw *earlier = &sort.draws[other];
+
+			if (earlier->key == draw->key || (program && sort_program_of(earlier->key) == program))
+			{
+				draw->group = earlier->group;
+				break;
+			}
+		}
+		sort.sorted[index] = (unsigned short)index;
+	}
+	qsort(sort.sorted, sort.count, sizeof(sort.sorted[0]), sort_draw_compare);
+	sort.replaying = TRUE;
+	for (index = 0; index < sort.count; index++)
+	{
+		struct sort_draw *draw = &sort.draws[sort.sorted[index]];
+
+		sort_state_apply(draw);
+		draw_indexed_vertices_untimed(draw->type, draw->count, draw->indices);
+		sort_learn(draw->key, gl_state.program);
+	}
+	sort.replaying = FALSE;
+	sort.count = 0;
+	sort_state_apply(&sort.last);
+}
+
+/* an indexed draw kept for later: FALSE to draw it now (after the kept
+ones, where it is not one to keep) */
+static BOOL sort_keep(D3DPRIMITIVETYPE type, UINT count, CONST WORD *indices)
+{
+	struct sort_draw *draw;
+
+	if (!sort.on || sort.replaying)
+		return FALSE;
+	if (!sort_draw_fits())
+	{
+		static int told; /* DEBUG */
+
+		if (told < 40 && getenv("HALO_D3D_WHO"))
+		{
+			told++;
+			platform_log("SORT apart: blend %lu z %lu/%lu func %lu stencil %lu func %lu ops %lu/%lu/%lu write %lx ref %lu vs %lu",
+				(unsigned long)D3D__RenderState[D3DRS_ALPHABLENDENABLE], (unsigned long)D3D__RenderState[D3DRS_ZENABLE],
+				(unsigned long)D3D__RenderState[D3DRS_ZWRITEENABLE], (unsigned long)D3D__RenderState[D3DRS_ZFUNC],
+				(unsigned long)D3D__RenderState[D3DRS_STENCILENABLE], (unsigned long)D3D__RenderState[D3DRS_STENCILFUNC],
+				(unsigned long)D3D__RenderState[D3DRS_STENCILFAIL], (unsigned long)D3D__RenderState[D3DRS_STENCILZFAIL],
+				(unsigned long)D3D__RenderState[D3DRS_STENCILPASS], (unsigned long)D3D__RenderState[D3DRS_STENCILWRITEMASK],
+				(unsigned long)D3D__RenderState[D3DRS_STENCILREF], current_program() ? current_program()->id : 0);
+		}
+		sort.apart++;
+		sort_flush();
+		return FALSE;
+	}
+	if (sort.count == SORT_DRAWS)
+		sort_flush();
+	if (!sort.draws && !(sort.draws = malloc(SORT_DRAWS * sizeof(*sort.draws))))
+		return FALSE;
+	draw = &sort.draws[sort.count];
+	sort_state_keep(draw, type, count, indices);
+	draw->key = sort_state_key();
+	draw->order = sort.count;
+	sort.count++;
+	sort.kept++;
+	return TRUE;
+}
+
+/* (HALO_GLES2_SORT_FLIP=n, for pictures: TRUE in the frames the changes
+are off, every other n; for the game's side of them too) */
+int d3d8_gl_flipped_off(void)
+{
+	static long flip = -1;
+
+	if (flip < 0)
+		flip = getenv("HALO_GLES2_SORT_FLIP") ? atol(getenv("HALO_GLES2_SORT_FLIP")) : 0;
+	return flip > 0 && (device.frame / (unsigned long)flip) % 2;
+}
+
+void d3d8_gl_sort_pass(int begin)
+{
+	static int allowed = -1;
+	static long flip = -1;
+
+	if (allowed < 0)
