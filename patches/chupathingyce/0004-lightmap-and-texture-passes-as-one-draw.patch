+#if defined(HALO_CONSOLE_GLES2) && defined(HALO_CONSOLE_PERFORMANCE_MODE)
+/* port: the lightmap pass and the texture pass of a part of the level as
+one draw (d3d8_gl.c, "fused"): the lightmap pass's draw is kept by the D3D
+layer, and the texture pass's draw of the same triangles is drawn with
+both. The render state is the lightmap pass's throughout: the texture
+pass's draw sets none. Its textures take the stages the lightmap and the
+normalization cube were on, so those are set again for each part. */
+void d3d8_gl_fuse_capture(int capture, int alpha);
+void d3d8_gl_fuse_end(void);
+void _rasterizer_environment_diffuse_texture_draw(
+	struct shader const *shader,
+	short bitmap_index,
+	long dynamic_triangle_buffer_index,
+	long first_triangle_index,
+	long triangle_count,
+	struct vertex_buffer const *vertex_buffer);
+
+static struct bitmap_data const *fused_lightmap_bitmap;
+
+void _rasterizer_environment_fused_lightmap_begin(
+	struct bitmap_data const *lightmap_bitmap)
+{
+	fused_lightmap_bitmap = lightmap_bitmap;
+	_rasterizer_environment_lightmap_begin(lightmap_bitmap);
+	return;
+}
+
+void _rasterizer_environment_fused_draw(
+	struct shader const *shader,
+	short bitmap_index,
+	long dynamic_triangle_buffer_index,
+	long first_triangle_index,
+	long triangle_count,
+	struct vertex_buffer const *vertex_buffer)
+{
+	int alpha = rasterizer_debug_options.environment_specular_mask_enabled != FALSE;
+
+	rasterizer_set_texture_direct(3, global_rasterizer_data->vector_normalization.index, 0);
+	D3DDevice_SetTextureState_Deferred(3, D3DTSS_ADDRESSU, D3DTADDRESS_CLAMP);
+	D3DDevice_SetTextureState_Deferred(3, D3DTSS_ADDRESSV, D3DTADDRESS_CLAMP);
+	D3DDevice_SetTextureState_Deferred(3, D3DTSS_ADDRESSW, D3DTADDRESS_CLAMP);
+	D3DDevice_SetTextureState_Deferred(3, D3DTSS_MAGFILTER, D3DTEXF_LINEAR);
+	D3DDevice_SetTextureState_Deferred(3, D3DTSS_MINFILTER, D3DTEXF_LINEAR);
+	D3DDevice_SetTextureState_Deferred(3, D3DTSS_MIPFILTER, D3DTEXF_LINEAR);
+	_rasterizer_environment_lightmap_begin(fused_lightmap_bitmap);
