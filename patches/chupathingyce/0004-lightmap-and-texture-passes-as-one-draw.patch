+/* ---------- two passes of the level's geometry as one draw (fused)
+
+The level's geometry is drawn once for its lightmaps (A: opaque, depth
+written) and once more for its textures (B: the same triangles, multiplied
+into A's pixels). On a console whose driver's cost is the draw itself that
+is half of the level's draws for nothing. Between d3d8_gl_fuse_capture(1)
+and (0) the game makes A's draw, which is kept and not drawn; then B's,
+which is drawn with A's state and a program made of both: A's vertex shader
+with B's four coordinates, A's pixel shader multiplied by B's, B's textures
+on units 4 to 7. Where the two cannot be one program (B's shaders are not
+the ones known here, or the program does not link), A is drawn, then B with
+the texture pass's blend and depth test: as it was. */
+#ifdef HALO_CONSOLE_GLES2
+#define FUSE_CAPTURES 8
+#define FUSE_PROGRAMS 192
+#define FUSE_CONSTANT_FIRST 12
+#define FUSE_CONSTANT_COUNT 7
+
+struct fuse_state
+{
+	DWORD render_state[D3DRS_MAX];
+	DWORD texture_state[D3DTSS_MAXSTAGES][D3DTSS_MAX];
+	D3DBaseTexture *textures[D3DTSS_MAXSTAGES];
+	D3DPalette *palettes[D3DTSS_MAXSTAGES];
+	struct vertex_shader_object *vertex_shader;
+	struct vertex_shader_object *program_slots[VERTEX_PROGRAM_SLOTS];
+	unsigned long program_address;
+	float constants[FUSE_CONSTANT_COUNT][4];
+	unsigned char streams[sizeof(((struct gl_device *)0)->streams)];
+	UINT base_vertex_index;
+	WORD *index_data;
+	int mcc;
+	D3DPRIMITIVETYPE type;
+	UINT count;
+	CONST WORD *indices;
+};
+
+struct fuse_program
+{
+	struct vertex_shader_object *program, *declaration;
+	unsigned long hash_a, hash_b;
+	struct nv2a_pixel_shader_key key_a, key_b;
+	int alpha;
+	/* (NULL: the two are not one program) */
+	struct program_entry *entry;
+	GLint constants, scale;
+	float constants_shadow[3][4], scale_shadow[4][4];
+};
+
+static struct
+{
+	int capturing, texturing, inside, active, failed, alpha;
+	int count, next;
+	struct fuse_state captures[FUSE_CAPTURES];
+	struct fuse_state *current;
+	struct nv2a_pixel_shader_key key_b;
+	float scale_b[4][4];
+	float constants_b[3][4];
+	struct fuse_program *programs[FUSE_PROGRAMS];
+	int program_count;
+	struct fuse_program *program;
+	unsigned long fused, apart, frame;
+} fuse;
+
+static void draw_indexed_vertices_untimed(D3DPRIMITIVETYPE primitive_type, UINT vertex_count, CONST WORD *index_data);
+
+static void fuse_state_keep(struct fuse_state *state, D3DPRIMITIVETYPE type, UINT count, CONST WORD *indices)
+{
+	memcpy(state->render_state, D3D__RenderState, sizeof(state->render_state));
+	memcpy(state->texture_state, D3D__TextureState, sizeof(state->texture_state));
+	memcpy(state->textures, device.textures, sizeof(state->textures));
+	memcpy(state->palettes, device.palettes, sizeof(state->palettes));
+	state->vertex_shader = device.vertex_shader;
+	memcpy(state->program_slots, device.program_slots, sizeof(state->program_slots));
+	state->program_address = device.program_address;
+	memcpy(state->constants, device.constants[FUSE_CONSTANT_FIRST], sizeof(state->constants));
+	memcpy(state->streams, device.streams, sizeof(state->streams));
+	state->base_vertex_index = device.base_vertex_index;
+	state->index_data = D3D__IndexData;
+	state->mcc = mcc_environment_shader_active();
+	state->type = type;
+	state->count = count;
+	state->indices = indices;
+}
+
+static void fuse_state_apply(const struct fuse_state *state)
+{
+	memcpy(D3D__RenderState, state->render_state, sizeof(state->render_state));
+	memcpy(D3D__TextureState, state->texture_state, sizeof(state->texture_state));
+	memcpy(device.textures, state->textures, sizeof(state->textures));
+	memcpy(device.palettes, state->palettes, sizeof(state->palettes));
+	device.vertex_shader = state->vertex_shader;
+	memcpy(device.program_slots, state->program_slots, sizeof(state->program_slots));
+	device.program_address = state->program_address;
+	constants_store(FUSE_CONSTANT_FIRST, state->constants, FUSE_CONSTANT_COUNT);
+	memcpy(device.streams, state->streams, sizeof(state->streams));
+	device.base_vertex_index = state->base_vertex_index;
+	D3D__IndexData = state->index_data;
+}
+
+/* text with every from replaced by to (the caller's to free; text is freed) */
+static char *fuse_replace(char *text, const char *from, const char *to)
+{
+	size_t from_length = strlen(from), to_length = strlen(to), count = 0, length;
+	const char *found;
+	char *result, *out;
+
+	if (!text)
+		return NULL;
+	for (found = strstr(text, from); found; found = strstr(found + from_length, from))
+		count++;
+	length = strlen(text) + count * to_length - count * from_length;
+	result = out = malloc(length + 1);
+	if (result)
+	{
+		const char *in = text;
+
+		while ((found = strstr(in, from)) != NULL)
+		{
+			memcpy(out, in, (size_t)(found - in));
+			out += found - in;
+			memcpy(out, to, to_length);
+			out += to_length;
+			in = found + from_length;
+		}
+		strcpy(out, in);
+	}
+	free(text);
+	return result;
+}
+
+/* text with more put in before its first (or last) appearance of at; NULL
+(and text freed) where it has none */
+static char *fuse_insert(char *text, const char *at, const char *more, BOOL last)
+{
+	char *place = NULL, *result;
+
+	if (text)
+	{
+		char *found;
+
+		for (found = strstr(text, at); found; found = last ? strstr(found + 1, at) : NULL)
+			place = found;
+	}
+	if (!place)
+	{
+		free(text);
+		return NULL;
+	}
+	result = malloc(strlen(text) + strlen(more) + 1);
+	if (result)
+	{
+		memcpy(result, text, (size_t)(place - text));
+		strcpy(result + (place - text), more);
+		strcat(result, place);
+	}
+	free(text);
+	return result;
+}
+
+/* whether B's vertex program is the texture pass's: the position, and four
+coordinates made of v4 and c[12..14], as fuse_vertex_source writes them */
+static BOOL fuse_vertex_b_known(struct vertex_shader_object *program)
+{
+	static struct vertex_shader_object *checked[4];
+	static BOOL known[4];
+	static int next;
+	int index;
+	char *source;
+	const char *found;
+	BOOL result = TRUE;
+
+	for (index = 0; index < 4; index++)
+	{
+		if (checked[index] == program)
+			return known[index];
+	}
+	source = nv2a_vertex_shader_to_glsl(program->instructions, program->instruction_count, 0, NULL, FALSE);
+	if (!source)
+		return FALSE;
+	for (found = strstr(source, "c["); found && result; found = strstr(found + 1, "c["))
+	{
+		long number = atol(found + 2);
+
+		if (found > source && (found[-1] == '_' || (found[-1] >= 'a' && found[-1] <= 'z')))
+			continue;
+		result = number <= 3 || (number >= 12 && number <= 14) || number == 58 || number == 59 || number == 192;
+	}
+	result = result && strstr(source, "B = c[13].xyzw;\n\tC = v4.xyzw;") && strstr(source, "B = c[14].xyzw;\n\tC = v4.xyzw;") &&
+		strstr(source, "B = c[12].xyyy;") && strstr(source, "B = c[12].zwww;") && strstr(source, "B = c[13].zzzz;") &&
+		strstr(source, "B = c[14].zzzz;") && strstr(source, "oT3.y = mac.y;") && !strstr(source, "oD0.") &&
+		!strstr(source, "oT0.z") && !strstr(source, "oT0.w") && !strstr(source, "oFog.");
+	free(source);
+	checked[next] = program;
+	known[next] = result;
+	next = (next + 1) % 4;
+	return result;
+}
+
+/* A's vertex shader with B's coordinates */
+static char *fuse_vertex_source(char *source)
+{
+	if (!source || !strstr(source, " in vec4 v4_in;"))
+	{
+		free(source);
+		return NULL;
+	}
+	source = fuse_insert(source, "uniform vec4 viewport_scale;",
+		"uniform vec4 fuse_c[3];\nout vec4 xU0;\nout vec4 xU1;\n", FALSE);
+	return fuse_insert(source, "}",
+		"\t{\n"
+		"\t\tvec2 fuse_b = vec2(dot(v4_in.xyz, fuse_c[1].xyz) + fuse_c[1].w, dot(v4_in.xyz, fuse_c[2].xyz) + fuse_c[2].w);\n"
+		"\t\txU0 = vec4(fuse_b, fuse_b * fuse_c[0].xy);\n"
+		"\t\txU1 = vec4(fuse_b * fuse_c[0].zw, fuse_b.x * fuse_c[1].z, fuse_b.y * fuse_c[2].z);\n"
+		"\t}\n", TRUE);
+}
+
+/* A's pixel shader, its color multiplied by B's (b is freed) */
+static char *fuse_fragment_source(char *a, char *b, BOOL alpha)
+{
+	static const char *const refused[] = { "discard", "bump_", "ps_c0", "ps_c1", "ps_final", "alpha_reference",
+		"texelFetch", "textureSize", "gl_FragCoord", NULL };
+	static const char *const coordinates[4] = { "xU0.xy", "xU0.zw", "xU1.xy", "xU1.zw" };
+	char *start = b ? strstr(b, "void main()\n{\n") : NULL;
+	char *end = start ? strstr(start, "\tresult = nv2a_finite(result);") : NULL;
+	char declarations[512] = "in vec4 xU0;\nin vec4 xU1;\nuniform vec4 fuse_scale[4];\n";
+	char *body, *function;
+	int index;
+
+	if (!a || !end)
+	{
+		free(a);
+		free(b);
+		return NULL;
+	}
+	*end = 0;
+	body = strdup(start + strlen("void main()\n{\n"));
+	for (index = 0; refused[index] && body; index++)
+	{
+		if (strstr(body, refused[index]))
+		{
+			free(body);
+			body = NULL;
+		}
+	}
+	for (index = 0; index < 4 && body; index++)
+	{
+		static const char *const kinds[] = { "sampler2D", "samplerCube", "sampler3D" };
+		char from[128], to[128];
+		int kind;
+
+		for (kind = 0; kind < 3; kind++)
+		{
+			snprintf(from, sizeof(from), "uniform %s tex%d;", kinds[kind], index);
+			if (strstr(b, from))
+			{
+				snprintf(to, sizeof(to), "uniform %s tex%d;\n", kinds[kind], index + 4);
+				strcat(declarations, to);
+			}
+		}
+		snprintf(from, sizeof(from), "(vec4(xT%d.xyz / (xT%d.w != 0.0 ? xT%d.w : 1.0), 1.0))", index, index, index);
+		snprintf(to, sizeof(to), "(vec4(%s, 0.0, 1.0))", coordinates[index]);
+		body = fuse_replace(body, from, to);
+		snprintf(from, sizeof(from), "xT%d", index);
+		snprintf(to, sizeof(to), "vec4(%s, 0.0, 1.0)", coordinates[index]);
+		body = fuse_replace(body, from, to);
+		snprintf(from, sizeof(from), "texture_lod_bias[%d]", index);
+		body = fuse_replace(body, from, "0.0");
+	}
+	for (index = 3; index >= 0 && body; index--)
+	{
+		char from[16], to[16];
+
+		snprintf(from, sizeof(from), "tex%d", index);
+		snprintf(to, sizeof(to), "tex%d", index + 4);
+		body = fuse_replace(body, from, to);
+	}
+	body = fuse_replace(body, "texture_scale", "fuse_scale");
+	body = fuse_replace(body, "xD0", "vec4(0.0, 0.0, 0.0, 1.0)");
+	body = fuse_replace(body, "xD1", "vec4(0.0, 0.0, 0.0, 1.0)");
+	body = fuse_replace(body, "xFog", "1.0");
+	free(b);
+	if (!body || strstr(body, "texture_lod_bias"))
+	{
+		free(body);
+		free(a);
+		return NULL;
+	}
+	function = malloc(strlen(body) + 128);
+	if (function)
+		sprintf(function, "vec4 fuse_b()\n{\n%s\treturn clamp(nv2a_finite(result), 0.0, 1.0);\n}\n", body);
+	free(body);
+	if (!function || !strstr(a, "\tfragment_color = clamp(result, 0.0, 1.0);") ||
+		strstr(strstr(a, "\tfragment_color = clamp(result, 0.0, 1.0);") + 1, "\tfragment_color = "))
+	{
+		free(function);
+		free(a);
+		return NULL;
+	}
+	a = fuse_insert(a, "vec4 nv2a_finite(", declarations, FALSE);
+	a = fuse_insert(a, "void main()\n", function, FALSE);
+	free(function);
+	return fuse_replace(a, "\tfragment_color = clamp(result, 0.0, 1.0);", alpha ?
+		"\tfragment_color = clamp(result, 0.0, 1.0) * fuse_b();" :
+		"\tfragment_color = clamp(result, 0.0, 1.0) * vec4(fuse_b().rgb, 1.0);");
+}
+
+/* the program of A's vertex program and pixel key with B's (fuse.key_b),
+NULL where they are not one */
+static struct program_entry *fuse_program_get(struct vertex_shader_object *program,
+	const struct nv2a_pixel_shader_key *key_a)
+{
+	unsigned long hash_a = hash_words(key_a, sizeof(*key_a)), hash_b = hash_words(&fuse.key_b, sizeof(fuse.key_b));
+	struct fuse_program *found;
+	char *vertex_source, *fragment_source;
+	int index;
+
+	for (index = 0; index < fuse.program_count; index++)
+	{
+		found = fuse.programs[index];
+		if (found->hash_a == hash_a && found->hash_b == hash_b && found->program == program &&
+			found->declaration == device.vertex_shader && found->alpha == fuse.alpha &&
+			words_equal(&found->key_a, key_a, sizeof(*key_a)) && words_equal(&found->key_b, &fuse.key_b, sizeof(fuse.key_b)))
+		{
+			fuse.program = found;
+			return found->entry;
+		}
+	}
+	if (fuse.program_count == FUSE_PROGRAMS || !(found = calloc(1, sizeof(*found))))
+		return NULL;
+	fuse.programs[fuse.program_count++] = found;
+	found->program = program;
+	found->declaration = device.vertex_shader;
+	found->hash_a = hash_a;
+	found->hash_b = hash_b;
+	found->key_a = *key_a;
+	found->key_b = fuse.key_b;
+	found->alpha = fuse.alpha;
+	memset(found->constants_shadow, 0xff, sizeof(found->constants_shadow));
+	memset(found->scale_shadow, 0xff, sizeof(found->scale_shadow));
+	fuse.program = found;
+	vertex_source = fuse_vertex_source(nv2a_vertex_shader_to_glsl(program->instructions, program->instruction_count,
+		device.vertex_shader->packed_mask, NULL, FALSE));
+	fragment_source = fuse_fragment_source(nv2a_pixel_shader_to_glsl(key_a), nv2a_pixel_shader_to_glsl(&fuse.key_b),
+		fuse.alpha);
+	if (vertex_source && fragment_source)
+	{
+		GLuint vertex = xgpu_shader_cache_compile(GL_VERTEX_SHADER, vertex_source, "vertex");
+		GLuint fragment = xgpu_shader_cache_compile(GL_FRAGMENT_SHADER, fragment_source, "pixel");
+
+		if (debug_settings.dump_shaders)
+		{
+			char path[512];
+			FILE *file;
+
+			snprintf(path, sizeof(path), "%s/fused_%08lx_%08lx.glsl", debug_settings.dump_shaders, hash_a, hash_b);
+			if ((file = fopen(path, "w")) != NULL)
+			{
+				fputs(vertex_source, file);
+				fputs("\n/* ---- */\n", file);
+				fputs(fragment_source, file);
+				fclose(file);
+			}
+		}
+		if (vertex && fragment)
+			found->entry = program_get(vertex, fragment);
+	}
+	free(vertex_source);
+	free(fragment_source);
+	if (found->entry)
+	{
+		state_program(found->entry->program);
+		found->constants = glGetUniformLocation(found->entry->program, "fuse_c");
+		found->scale = glGetUniformLocation(found->entry->program, "fuse_scale");
+		for (index = 0; index < D3DTSS_MAXSTAGES; index++)
+		{
+			char name[8];
+			GLint location;
+
+			snprintf(name, sizeof(name), "tex%d", index + D3DTSS_MAXSTAGES);
+			location = glGetUniformLocation(found->entry->program, name);
+			if (location >= 0)
+				glUniform1i(location, index + D3DTSS_MAXSTAGES);
+		}
+	}
+	else
+		platform_log("GPU: a lightmap and a texture pass (vertex shader %lu, pixel shaders %08lx and %08lx) are not "
+			"one program here: drawn one after the other", program->id, hash_a, hash_b);
+	return found->entry;
+}
+
+/* B's pixel key, its textures bound on units 4 to 7 */
+static void fuse_key_b(void)
+{
+	struct nv2a_pixel_shader_key *key = &fuse.key_b;
+	int stage;
+
+	memset(key, 0, sizeof(*key));
+	memcpy(key->combiner_state, D3D__RenderState, sizeof(key->combiner_state));
+	memset(&key->combiner_state[D3DRS_PSCONSTANT0_0], 0, 16 * sizeof(DWORD));
+	key->combiner_state[D3DRS_PSFINALCOMBINERCONSTANT0] = 0;
+	key->combiner_state[D3DRS_PSFINALCOMBINERCONSTANT1] = 0;
+	key->texture_modes = D3D__RenderState[D3DRS_PSTEXTUREMODES];
+	texture_unit_base = D3DTSS_MAXSTAGES;
+	bind_textures(key, fuse.scale_b);
+	texture_unit_base = 0;
+	for (stage = 0; stage < D3DTSS_MAXSTAGES; stage++)
+	{
+		key->alpha_kill[stage] = D3D__TextureState[stage][D3DTSS_ALPHAKILL] == D3DTALPHAKILL_ENABLE;
+		key->color_sign[stage] = (unsigned char)((D3D__TextureState[stage][D3DTSS_COLORSIGN] >> 28) & 0xf);
+	}
+	key->coverage_alpha = 0;
+	key->point_threshold = 0;
+	key->fog_enable = D3D__RenderState[D3DRS_FOGENABLE] != 0;
+	key->fog_table_mode = (unsigned char)D3D__RenderState[D3DRS_FOGTABLEMODE];
+}
+
+/* (prepare_draw's, with the fused program current) */
+static void fuse_uniforms(void)
+{
+	uniform_vec4(fuse.program->constants, fuse.program->constants_shadow[0], fuse.constants_b[0], 3);
+	uniform_vec4(fuse.program->scale, fuse.program->scale_shadow[0], fuse.scale_b[0], 4);
+}
+
+/* B's draw: with the A kept for it as one draw, or the two as they were */
+static void fuse_draw(D3DPRIMITIVETYPE type, UINT count, CONST WORD *indices)
+{
+	static struct fuse_state b;
+	static const DWORD forced[][2] = {
+		{ D3DRS_ALPHABLENDENABLE, TRUE }, { D3DRS_SRCBLEND, D3DBLEND_DESTCOLOR }, { D3DRS_DESTBLEND, D3DBLEND_ZERO },
+		{ D3DRS_BLENDOP, D3DBLENDOP_ADD }, { D3DRS_ALPHATESTENABLE, FALSE }, { D3DRS_ZFUNC, D3DCMP_EQUAL },
+		{ D3DRS_ZWRITEENABLE, FALSE },
+	};
+	struct fuse_state *a = fuse.next < fuse.count ? &fuse.captures[fuse.next] : NULL;
+	DWORD kept[sizeof(forced) / sizeof(forced[0])], kept_write;
+	unsigned long index;
+
+	fuse.next++;
+	fuse.inside = TRUE;
+	if (a)
+	{
+		BOOL fusable = a->count == count && a->indices == indices && a->type == type &&
+			fuse_vertex_b_known(current_program());
+
+		fuse_state_keep(&b, type, count, indices);
+		if (fusable)
+		{
+			fuse_key_b();
+			memcpy(fuse.constants_b, device.constants[FUSE_CONSTANT_FIRST], sizeof(fuse.constants_b));
