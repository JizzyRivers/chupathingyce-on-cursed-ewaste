+	d3d8_gl_fuse_capture(TRUE, alpha);
+	_rasterizer_environment_lightmap_draw(
+		shader,
+		bitmap_index,
+		dynamic_triangle_buffer_index,
+		first_triangle_index,
+		triangle_count,
+		vertex_buffer);
+	d3d8_gl_fuse_capture(FALSE, alpha);
+	_rasterizer_environment_diffuse_texture_draw(
+		shader,
+		bitmap_index,
+		dynamic_triangle_buffer_index,
+		first_triangle_index,
+		triangle_count,
+		vertex_buffer);
+	d3d8_gl_fuse_end();
+	return;
+}
