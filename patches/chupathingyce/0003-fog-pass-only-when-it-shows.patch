+/* port: whether this frame's fog pass can change a pixel. With no planar
+fog and an atmospheric fog that is none (density 0: ratrace) or too thin to
+reach a thousandth anywhere in the level (carousel's: 0.001 at 10000 units,
+in a level 46 across), every fragment's alpha rounds to 0 and the alpha
+test drops it, yet the pass was a draw for each of the level's materials
+in view. */
+static boolean environment_fog_visible = TRUE;
+
+static boolean environment_fog_can_show(
+	void)
+{
+	struct render_fog const *fog = &global_window_parameters.fog;
+	struct structure_bsp *structure_bsp = global_structure_bsp_get();
+	real x, y, z, reach, range, density;
+
+	if (fog->planar_maximum_density > 0.0f)
+	{
+		return TRUE;
+	}
+	if (fog->atmospheric_maximum_density <= 0.0f)
+	{
+		return FALSE;
+	}
+	if (!structure_bsp)
+	{
+		return TRUE;
+	}
+	/* (nothing in the level is further from the camera than its bounds'
+	diagonal, with the camera inside them: twice that, for one outside) */
+	x = structure_bsp->world_bounds.x1 - structure_bsp->world_bounds.x0;
+	y = structure_bsp->world_bounds.y1 - structure_bsp->world_bounds.y0;
+	z = structure_bsp->world_bounds.z1 - structure_bsp->world_bounds.z0;
+	reach = 2.0f * (fabsf(x) + fabsf(y) + fabsf(z));
+	range = fog->atmospheric_maximum_distance - fog->atmospheric_minimum_distance;
+	if (range <= 0.0f || reach <= fog->atmospheric_minimum_distance)
+	{
+		return reach > fog->atmospheric_minimum_distance;
+	}
+	density = fog->atmospheric_maximum_density * (reach - fog->atmospheric_minimum_distance) / range;
+	return density >= 0.001f;
+}
