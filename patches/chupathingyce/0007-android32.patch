diff --git a/port/linux/src/text_hires.c b/port/linux/src/text_hires.c
index df894bf48..4c071b208 100644
--- a/port/linux/src/text_hires.c
+++ b/port/linux/src/text_hires.c
@@ -42,7 +42,14 @@ when the settings change while the game runs.
 /* (the Xbox maps' tags and a Custom Edition loc.map's, which share names,
 each at its oversamples) */
 #define MAXIMUM_FONTS 16
+#ifdef HALO_ANDROID32
+/* a Mali driver copies a whole texture for each update that queued draws may still read, and a
+menu's text updates its atlas dozens of times a frame: the atlas is one channel, and 1024 square
+(1 MB a copy, not 16 MB), and the menus' glyphs fit */
+#define ATLAS_SIZE 1024
+#else
 #define ATLAS_SIZE 2048
+#endif
 /* clear texels around each glyph, so that filtering never reaches the next */
 #define ATLAS_PADDING 2
 #define GLYPH_CACHE_SIZE 4096
@@ -554,11 +561,32 @@ unsigned int text_hires_atlas_texture(unsigned long data)
 		glBindTexture(GL_TEXTURE_2D, atlas_texture);
 		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_BASE_LEVEL, 0);
 		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAX_LEVEL, 0);
+#ifdef HALO_ANDROID32
+		/* (white, the coverage its alpha: sampled as the RGBA the other builds have) */
+		glTexImage2D(GL_TEXTURE_2D, 0, GL_R8, ATLAS_SIZE, ATLAS_SIZE, 0, GL_RED, GL_UNSIGNED_BYTE, NULL);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_SWIZZLE_R, GL_ONE);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_SWIZZLE_G, GL_ONE);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_SWIZZLE_B, GL_ONE);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_SWIZZLE_A, GL_RED);
+#else
 		glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, ATLAS_SIZE, ATLAS_SIZE, 0, GL_RGBA, GL_UNSIGNED_BYTE, NULL);
+#endif
 		xgpu_gl_state_invalidate();
 		dirty_top = 0;
 		dirty_bottom = ATLAS_SIZE;
 	}
+#ifdef HALO_ANDROID32
+	if (dirty_top < dirty_bottom)
+	{
+		glBindTexture(GL_TEXTURE_2D, atlas_texture);
+		glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+		glTexSubImage2D(GL_TEXTURE_2D, 0, 0, dirty_top, ATLAS_SIZE, (GLsizei)(dirty_bottom - dirty_top), GL_RED,
+			GL_UNSIGNED_BYTE, atlas + (long)dirty_top * ATLAS_SIZE);
+		xgpu_gl_state_invalidate();
+		dirty_top = ATLAS_SIZE;
+		dirty_bottom = 0;
+	}
+#else
 	if (dirty_top < dirty_bottom)
 	{
 		/* (white, the glyph's coverage its alpha, as the maps' fonts are) */
@@ -584,6 +612,7 @@ unsigned int text_hires_atlas_texture(unsigned long data)
 			dirty_bottom = 0;
 		}
 	}
+#endif
 	return atlas_texture;
 }
 
